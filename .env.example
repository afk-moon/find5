# Copy to .env.local. Everything is optional for local use: without these, the app runs with demo
# login and an embedded database, and Discord features quietly turn off.

# Public URL of the app (used for Discord links and the OAuth redirect). Locally: http://localhost:3000
APP_URL=http://localhost:3000

# Signs the login cookie. Required in production: any long random string.
AUTH_SECRET=

# ── Discord (https://discord.com/developers/applications) ──
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# OAuth2 → Client Secret (the client ID is the application ID)
DISCORD_CLIENT_SECRET=
# Optional: register slash commands in just your server (instant)
DISCORD_GUILD_ID=

# ── Database ──
# Leave empty locally to use the embedded Postgres in .data/. In production use Supabase/Neon/etc.
DATABASE_URL=
# Demo data: seeded automatically locally; set to 0 to start empty, or 1 to seed a hosted DB.
SEED_DEMO=

# Protects /api/cron/daily (Vercel sends it automatically as a Bearer token) and /api/cron/tick
CRON_SECRET=
# The bot's own posts (from /api/cron/tick, pinged every 5 minutes): which games (comma-separated names)
# and whose 11 AM. These are the defaults.
# AUTO_POST_GAMES=Valorant
# AUTO_POST_TIME_ZONE=America/Los_Angeles
