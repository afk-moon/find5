{
  "name": "discapp",
  "version": "0.1.0",
  "private": true,
  "description": "Receptionist: schedule Valorant 5-stacks across time zones, plan around dinner, and sync hybrid WFH days.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/check-setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node -e \"require('fs').rmSync('.data', { recursive: true, force: true })\"",
    "discord:register": "node --env-file=.env.local scripts/register-commands.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.3",
    "luxon": "3.7.2",
    "next": "16.2.10",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.5",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
